{
  "name": "@eddalabs/stealth-contract",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "DKSAP stealth crypto + Midnight Compact modules for Veil Protocol",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js",
      "default": "./dist/services/index.js"
    },
    "./crypto/types": {
      "types": "./dist/crypto/types.d.ts",
      "import": "./dist/crypto/types.js",
      "default": "./dist/crypto/types.js"
    },
    "./crypto/stealth": {
      "types": "./dist/crypto/stealth.d.ts",
      "import": "./dist/crypto/stealth.js",
      "default": "./dist/crypto/stealth.js"
    },
    "./bridge": {
      "types": "./dist/bridge/index.d.ts",
      "import": "./dist/bridge/index.js",
      "default": "./dist/bridge/index.js"
    }
  },
  "scripts": {
    "compact": "compact compile +0.28.0 src/stealth.compact src/managed/stealth",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:crypto-lifecycle": "tsx src/crypto/test-stealth.ts",
    "test:bridge": "tsx src/bridge/test-bridge.ts",
    "test:e2e": "tsx src/test-e2e.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.14.0",
    "@noble/hashes": "^1.7.1",
    "@noble/secp256k1": "^2.1.0",
    "ethers": "^6.13.5"
  },
  "devDependencies": {
    "tsx": "^4.22.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.0"
  }
}
