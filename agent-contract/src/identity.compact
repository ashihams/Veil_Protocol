pragma language_version >= 0.20;

import CompactStandardLibrary;

// Auto-incrementing agent ID. Post-increment value = agentId (first registered = 1).
export ledger agentCounter: Counter;

// agentIdKey = SHA-256(UTF-8 decimal agentId) → SHA-256(agentURI). URIs off-chain.
export ledger agentUriHash: Map<Bytes<32>, Bytes<32>>;

// agentIdKey → wallet address (Bytes<32>). Zero value = unset.
export ledger agentWallet: Map<Bytes<32>, Bytes<32>>;

// agentIdKey → owner public key (Bytes<32>). Set at registration; used for ownership checks.
export ledger agentOwner: Map<Bytes<32>, Bytes<32>>;

// SHA-256(agentId ++ metaKey) → SHA-256(metaValue). Raw strings stay off-chain.
export ledger metadataStore: Map<Bytes<32>, Bytes<32>>;

// Event substitutes: Compact has no emit; off-chain indexers poll these counters.
export ledger registrationCount: Counter;
export ledger uriUpdateCount: Counter;
export ledger metadataSetCount: Counter;

// Register a new agent. The caller supplies the URI hash, owner key, and map key for the new id.
// agentIdKey must be SHA-256(UTF-8 decimal agentId) where agentId = agentCounter.read() after increment.
// Read agentCounter after this call to obtain the assigned agentId.
// MVP: no ownership proof required — production adds witness ownerProof (see contracts/IdentityRegistry.compact).
export circuit register(uriHash: Bytes<32>, ownerKey: Bytes<32>, agentIdKey: Bytes<32>): [] {
  agentCounter.increment(1);
  agentUriHash.insert(disclose(agentIdKey), disclose(uriHash));
  agentOwner.insert(disclose(agentIdKey), disclose(ownerKey));
  registrationCount.increment(1);
}

// Update the URI hash for an existing agent.
export circuit setAgentURI(agentIdKey: Bytes<32>, newUriHash: Bytes<32>): [] {
  agentUriHash.insert(disclose(agentIdKey), disclose(newUriHash));
  uriUpdateCount.increment(1);
}

// Write a metadata entry. compositeKey = SHA-256(agentId ++ metaKey) computed off-chain.
export circuit setMetadata(compositeKey: Bytes<32>, valueHash: Bytes<32>): [] {
  metadataStore.insert(disclose(compositeKey), disclose(valueHash));
  metadataSetCount.increment(1);
}

// Bind a payment wallet address to an agent.
export circuit setAgentWallet(agentIdKey: Bytes<32>, walletBytes: Bytes<32>): [] {
  agentWallet.insert(disclose(agentIdKey), disclose(walletBytes));
}

// Clear the wallet binding by writing a zero value.
// The TypeScript layer treats all-zero Bytes<32> as "unset".
export circuit unsetAgentWallet(agentIdKey: Bytes<32>): [] {
  agentWallet.insert(disclose(agentIdKey), pad(32, ""));
}
